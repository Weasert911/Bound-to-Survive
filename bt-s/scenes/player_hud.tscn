[sub_resource type="Shader" id="Shader_ocgqw"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear;

// =====================================================
// CORE STATE
// =====================================================
uniform float global_strength = 1.0;
uniform float sanity = 1.0;          // 1 = calm, 0 = broken
uniform float ghost_proximity = 0.0; // 0 = far, 1 = inside you
uniform float flash = 0.0;
uniform float time_scale = 1.0;

// =====================================================
// VISUAL IDENTITY
// =====================================================
uniform float pixel_size = 260.0;
uniform float color_steps = 56.0;
uniform float chroma = 0.8;

// =====================================================
// HORROR SIGNALS
// =====================================================
uniform float grain = 0.22;
uniform float vignette = 1.8;
uniform float flicker = 0.08;
uniform float scanlines = 0.15;
uniform float static_noise = 0.35;
uniform float decay = 0.45;

// =====================================================
// PSYCHO / BODY REACTION
// =====================================================
uniform float nausea = 0.35;
uniform float ghost_trail = 0.35;
uniform float memory_drag = 0.35; // time distortion
uniform float perception_warp = 0.4;

// =====================================================
// HELPERS
// =====================================================
float rand(vec2 p){
	return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453);
}

vec2 pixelate(vec2 uv){
	vec2 res = vec2(textureSize(SCREEN_TEXTURE, 0));
	vec2 count = res / pixel_size;
	return floor(uv * count) / count;
}

vec3 quantize(vec3 c){
	return floor(c * color_steps) / color_steps;
}

vec3 chroma_sample(vec2 uv){
	float off = chroma * 0.002;
	return vec3(
		texture(SCREEN_TEXTURE, uv + vec2(off,0)).r,
		texture(SCREEN_TEXTURE, uv).g,
		texture(SCREEN_TEXTURE, uv - vec2(off,0)).b
	);
}

// =====================================================
// MAIN
// =====================================================
void fragment(){
	float t = TIME * time_scale;
	vec2 uv = SCREEN_UV;

	// =====================================================
	// PERCEPTION WARP (SUBTLE BUT EVIL)
	// =====================================================
	float mind = (1.0 - sanity);
	uv += vec2(
		sin(uv.y * 12.0 + t * 1.3),
		cos(uv.x * 9.0 + t * 1.1)
	) * perception_warp * mind * 0.004;

	// =====================================================
	// NAUSEA / INNER EAR FAILURE
	// =====================================================
	uv.x += sin(t * 1.7) * nausea * ghost_proximity * 0.01;
	uv.y += cos(t * 1.2) * nausea * ghost_proximity * 0.008;

	// =====================================================
	// PIXEL MEMORY SNAP
	// =====================================================
	vec2 puv = pixelate(uv);
	vec3 col = chroma_sample(puv);

	// =====================================================
	// MEMORY GHOSTS (AFTERIMAGE FROM WRONG TIME)
	// =====================================================
	vec2 memory_uv = puv + vec2(
		sin(t * 0.7) * memory_drag * 0.004,
		cos(t * 0.6) * memory_drag * 0.003
	);
	vec3 memory = texture(SCREEN_TEXTURE, memory_uv).rgb;
	col = mix(col, memory, ghost_trail * (1.0 - sanity));

	// =====================================================
	// FILM GRAIN (ALIVE)
	// =====================================================
	col += (rand(uv * t * 1200.0) - 0.5) * grain;

	// =====================================================
	// SCANLINES (BREATHING)
	// =====================================================
	col -= sin(uv.y * 900.0 + t * 6.0) * scanlines * 0.05;

	// =====================================================
	// FLICKER (HEARTBEAT-LIKE)
	// =====================================================
	col *= 1.0 + sin(t * 50.0 + ghost_proximity * 6.0) * flicker;

	// =====================================================
	// COLOR DECAY (SANITY KILLER)
	// =====================================================
	col *= vec3(
		1.0 - decay * 0.25 * mind,
		1.0 - decay * 0.12 * mind,
		1.0 - decay * 0.35 * mind
	);

	// =====================================================
	// STATIC NOISE (WHEN IT WANTS YOU GONE)
	// =====================================================
	col += (rand(vec2(uv.y * 800.0, t)) - 0.5)
		* static_noise * ghost_proximity * 0.08;

	// =====================================================
	// VIGNETTE (TUNNEL VISION)
	// =====================================================
	float d = distance(uv, vec2(0.5));
	col *= 1.0 - smoothstep(0.25, 0.9, d) * vignette;

	// =====================================================
	// COLOR QUANTIZATION (PSX DEATH)
	// =====================================================
	col = quantize(col);

	// =====================================================
	// FLASH / GHOST PRESSURE
	// =====================================================
	col += flash * vec3(1.0, 0.85, 0.7);
	col += vec3(
		ghost_proximity * 0.15,
		0.0,
		ghost_proximity * 0.25
	);

	// =====================================================
	// FINAL MIX
	// =====================================================
	vec3 base = texture(SCREEN_TEXTURE, SCREEN_UV).rgb;
	col = mix(base, col, global_strength);

	COLOR = vec4(clamp(col, 0.0, 1.0), 1.0);
}
"

